# Alt er valgfritt. Appen starter og alle tester kjører uten .env.
PREDIKTOR=auto            # baseline | modell | auto
LLM_MODUS=test            # test | ekte  — test krever ingen nøkkel
OPENROUTER_API_KEY=<din-nøkkel-her>   # bare for LLM_MODUS=ekte. Kursnøkkel fra faglærer, med bruksgrense. Står bare i .env, aldri i git.
LLM_MODELL=deepseek/deepseek-v4.1-flash-1017   # beslutning 13
LLM_ROUTING=floor         # prisgulv: billigste leverandør av modellen
LLM_MAKS_KALL=20          # ekte forsøk per prosess (per Vercel-instans)
LLM_FEIL_TTL_S=300        # sekunder en feil caches før neste besøk prøver igjen
LLM_TIMEOUT_S=8
LLM_RESONNERING=none      # reasoning.effort hos OpenRouter: none | low | high | max (none: ingen tokens til resonnering)
